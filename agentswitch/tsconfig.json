{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": [
      "node"
    ],
    "paths": {
      "@agentswitch/contracts": [
        "./packages/contracts/src/index.ts"
      ],
      "@agentswitch/worker-core": [
        "./packages/worker-core/src/index.ts"
      ],
      "@agentswitch/crypto": [
        "./packages/crypto/src/index.ts"
      ],
      "@agentswitch/relay-core": [
        "./packages/relay-core/src/index.ts"
      ]
    },
    "baseUrl": "."
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts"
  ]
}
