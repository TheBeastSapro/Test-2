__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/

.env
# Every other env file too. `.env.local` and `.env.production` hold the same kind of
# thing `.env` does, and `.env` alone does not match them. The example is the one that
# is meant to be tracked — it holds defaults, not secrets.
.env.*
!.env.example
*.db
*.db-journal
# SQLite writes these two beside the database and they hold page data, so a commit
# that catches them commits rows. `*.db` did not cover them and two of them landed
# in a commit before anyone noticed.
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
storage/

# Cloud-backup staging and restore trees. A git working copy of one install's work,
# living beside storage/ rather than inside it — see docs/CLOUD.md for why it cannot be
# inside. Committing it into the Forgecast source repo would put an operator's scripts in
# the app's own history, and a nested .git directory into a tracked tree.
.forgecast-cloud/
.forgecast-restore/

# Private keys, certificates and credential drops, by the names tools hand out. None of
# these belong in the repo, so the pattern is here rather than a review catching it.
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
id_rsa*
id_ed25519*
credentials.json
client_secret*.json
token.json
*.log
.pytest_cache/
.ruff_cache/

# Remotion renderer (opt-in backend)
node_modules/
remotion/out/

# Packaged releases, built by tools/package.py
dist/

# Chat attachments. They live inside the app root because the agent is sandboxed to
# it, which means they land in the repo when developing — they are context for one
# conversation, not source.
attachments/

# The bundled toolchain: Node, the Claude CLI, and ffmpeg on Windows. Downloaded, not
# authored, and deleting it is the uninstall.
runtime/

# The operator's own scripting documents. They belong outside this tree entirely — the
# default is ~/Forgecast/scripting-library and `forgecast/scripting/library.py` reads
# them from there — but they are somebody else's licensed work, so a copy that lands in
# here by hand must not become a commit that cannot be taken back. The glob covers the
# duplicate folder that appears the first time one is backed up. This does not match
# forgecast/scripting/, which is this project's own code.
scripting-library*/
