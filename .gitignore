# python
__pycache__/
*.pyc

# sound-designer working files (per-video, not source)
assets/
stems/
manifest.json
cues.json
cues.md
*.mp3
*.mp4
*.wav

# python bytecode from compileall
**/__pycache__/

# never commit a profile — it can carry an API key.
# The key-free calibration lives at voice-calibration.json, which IS committed,
# because the container is not storage and the profile died with it every
# session. Pass that file to --profile. This guard stays so a real studio
# export dropped here can never be committed by accident.
voiceover_profile.json
**/voiceover_profile.json
lexicon.json

# voiceover run artifacts — the pipeline's working directory (section takes,
# stitch, ASR caches, spend ledger). Regenerable from script.txt; the audio in
# it is already covered by *.mp3 / *.wav above.
work/out/
# transient stage logs — rewritten on every run; the findings that matter
# are carried in commit messages and the observation log instead.
work/*.log
