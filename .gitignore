# python
__pycache__/
*.pyc

# sound-designer working files (per-video, not source)
assets/
stems/
manifest.json
cues.json
cues.md
*.mp3
*.mp4
*.wav

# python bytecode from compileall
**/__pycache__/

# never commit a profile — it can carry an API key
voiceover_profile.json
**/voiceover_profile.json
lexicon.json

# horror-pipeline: node deps and Remotion build output
node_modules/
**/node_modules/
horror-pipeline/engine/remotion-engine/out/
.remotion/

# horror-pipeline: downloaded creature art is a rebuildable CACHE, not source.
# The durable artifact is materials/<creature>.json, which carries every
# source_url, phash, description and approval flag. Re-running the crawler
# rebuilds the binaries from that file. Never commit the binaries: one video
# is roughly 200 MB and this repo has to stay clonable.
horror-pipeline/projects/*/materials/*/
horror-pipeline/projects/*/work/
horror-pipeline/projects/*/out/
horror-pipeline/projects/*/audio/

# ...but the approval record itself must always be committed.
!horror-pipeline/projects/*/materials/*.json

# The contact sheet is 1.3 MB of inlined base64 regenerated from that JSON by
# `tools/contact_sheet.py build`. Derived, not source.
horror-pipeline/projects/*/materials/contact-sheet.html

# competitor research: extracted frames and sprite tiles are a rebuildable cache
horror-pipeline/research/*/frames/

# horror-pipeline: the renderer's public/ staging directories are POPULATED BY
# A COPY STEP before each render, from sources that are already committed:
# cutouts rebuild from materials/<creature>.json via clean_cutouts.py, plates
# from make_plates.py, illustrations from projects/*/illus/illustrations.json,
# and the mix from mix_audio.py. Committing them would double several MB of
# binaries that no one edits by hand. public/fonts and public/js are NOT here:
# those are real source and stay tracked.
horror-pipeline/engine/hyperframes-engine/public/assets/
horror-pipeline/engine/hyperframes-engine/public/illus/
horror-pipeline/engine/hyperframes-engine/public/plates/
horror-pipeline/engine/hyperframes-engine/public/audio/
