# ---- core ----
FORGECAST_SECRET_KEY=change-me-to-a-long-random-string
# Fernet key for encrypting user-supplied provider keys at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FORGECAST_ENCRYPTION_KEY=
FORGECAST_DATABASE_URL=sqlite:///./forgecast.db
# FORGECAST_DATABASE_URL=postgresql+psycopg://forgecast:forgecast@localhost:5432/forgecast
FORGECAST_STORAGE_DIR=./storage
FORGECAST_BASE_URL=http://localhost:8000

# ---- scripting styles ----
# A folder of YOUR OWN scripting documents, read while a prompt is built and never
# copied, committed or packaged. One subfolder per style; loose .md/.txt/.markdown files
# form a single style named after the folder. Pick each channel's style on its page.
#
# Keep this OUTSIDE the Forgecast folder. Anything under it can be committed by accident
# and the packager refuses to ship a `scripting-library` directory precisely because that
# accident is the one worth designing against. Empty means no local styles — the built-in
# house method is always available and needs no folder.
# Default: ~/Forgecast/scripting-library
FORGECAST_SCRIPTING_DIR=

# ---- provider mode ----
# mock  = no network, no spend. Deterministic fake media. Use this for development.
# live  = real provider APIs. Costs real money.
FORGECAST_PROVIDER_MODE=mock

# ---- platform-owned provider keys (fallback when a user has not brought their own) ----
FORGECAST_OPENAI_API_KEY=
FORGECAST_ANTHROPIC_API_KEY=
FORGECAST_ELEVENLABS_API_KEY=
FORGECAST_FAL_KEY=
FORGECAST_RUNWAY_API_KEY=
FORGECAST_HEYGEN_API_KEY=

# ---- YouTube OAuth (for publish node) ----
FORGECAST_YOUTUBE_CLIENT_ID=
FORGECAST_YOUTUBE_CLIENT_SECRET=

# ---- cloud backup (off) ----
# Mirrors the WORK — scripts, briefs, research, shot lists, captions, learned styles,
# skills and the run records — into a private GitHub repository. It does NOT mirror the
# renders: GitHub blocks files over 100 MiB and a repository that collects video never
# gets smaller again. docs/CLOUD.md is the full split and the reasoning.
#
# Leave this false. The operator turns it on in the app, which records the decision in
# storage/cloud.json — this variable only seeds the default for a fresh install, so a
# container or a headless deployment can arrive pre-enabled.
FORGECAST_CLOUD_SYNC=false
# The OAuth app client ID for the GitHub device flow. Not a secret: device flow sends no
# client secret at all, which is why it is the only flow suitable for an app that ships
# as a zip. Empty means this build has no GitHub app registered and backup says so
# instead of showing a code that cannot work.
FORGECAST_GITHUB_CLIENT_ID=

# ---- worker ----
FORGECAST_WORKER_CONCURRENCY=2
FORGECAST_WORKER_POLL_SECONDS=2

# ---- research search providers (one is enough; Tavily preferred) ----
FORGECAST_TAVILY_API_KEY=
FORGECAST_BRAVE_API_KEY=

# ---- sound effects ----
# The middle tier of the effect chain, between the music subscription and the open web.
# Free, and the token meters rather than bills — so it does not breach the rule that this
# app runs on subscriptions rather than on keys that can run up a balance. Leave it empty
# and the chain simply skips that tier: the subscription still answers, and a named sound
# can still be fetched if the run asked for one.
FORGECAST_FREESOUND_API_KEY=

# ---- private instance ----
# Registration is CLOSED by default. Only open this if you want other people to be
# able to create accounts on your instance.
FORGECAST_ALLOW_SIGNUP=false
# The owner account the container creates on first start. Bootstrapping is idempotent:
# a restart will not recreate the account or re-grant credits.
FORGECAST_OWNER_EMAIL=
FORGECAST_OWNER_PASSWORD=
FORGECAST_OWNER_GRANT=10000
FORGECAST_OWNER_CHANNEL=My Channel
# How long a signed media URL stays valid, in seconds. Long enough to watch a render
# without the link dying mid-playback; shorten it if you paste links around.
FORGECAST_MEDIA_URL_TTL_SECONDS=21600

# ---- reachability (docker compose) ----
# 127.0.0.1 keeps the port on loopback only, which is what makes it private. Put a
# reverse proxy or a tunnel in front rather than changing this to 0.0.0.0 — see
# DEPLOY.md.
FORGECAST_PUBLISH_ADDR=127.0.0.1
# Set to the proxy's address when you run one, so forwarded headers are trusted.
FORGECAST_FORWARDED_ALLOW_IPS=127.0.0.1

# Which encoder renders video on this machine: cpu, nvidia or intel.
#
# Empty is the CPU (libx264), which is always present and gives the best quality per
# byte. An NVIDIA or Intel GPU encodes far faster — including small cards that cannot
# generate a single frame of video, because encoding is a fixed-function block rather
# than the tensor cores — at the cost of a slightly larger file for the same picture.
#
# A value this machine cannot actually run falls back to the CPU rather than failing a
# render that has already paid for a script, a voiceover and eighty shots. That check is
# a trial encode, not `ffmpeg -encoders`: plenty of builds list h264_nvenc on machines
# with no NVIDIA driver, where it is listed, selectable, and dies at the first clip.
#
# GET /api/encoders reports what this machine can really do.
FORGECAST_VIDEO_ENCODER=

# ---- reading reference videos when the platform refuses ----
# Every measurement that reverse-engineers a reference's editing — cuts per minute,
# motion, palette, grade — runs on decoded frames, so a refused download does not make
# the analysis worse, it removes it entirely.
#
# Refusals are almost always the IP range rather than the URL: datacentre and VPS
# addresses get blocked ("HTTP 403", "Sign in to confirm you're not a bot") where a home
# connection does not. Running Forgecast on your own machine usually needs neither of
# these. A container, a VPS or a work network often needs one.
#
# A browser you are already signed into — chrome, firefox, edge, brave, safari, chromium.
# Nothing to export; yt-dlp reads the profile directly. Not available where there is no
# browser installed, which is most servers.
FORGECAST_COOKIES_FROM_BROWSER=
# Or an exported cookies.txt in Netscape format. The only option on a headless box.
# Takes precedence over the browser setting when the file exists.
FORGECAST_COOKIES_FILE=

# ---- footage vendors (free lane) ----
# B-roll is ~90% of what a video costs. The free lane searches NASA, Internet Archive
# (collection allow-listed), Pexels and Pixabay before generating anything, and a beat
# it can serve costs nothing at all.
#
# These two meter, they do not bill — the same category as FORGECAST_FREESOUND_API_KEY,
# so they do not breach the subscriptions-not-API-keys rule. Both are free to obtain.
#
# They matter more than they look. NASA and Internet Archive need no key but reach old
# film; a channel about anything recent gets little from them. Pexels and Pixabay are
# where a modern shot comes from. Without these the free lane still runs and rarely wins.
#   https://www.pexels.com/api/    https://pixabay.com/api/docs/
FORGECAST_PEXELS_API_KEY=
FORGECAST_PIXABAY_API_KEY=
