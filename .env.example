# Copy to .env and fill in. .env is gitignored — never commit it.
# This repo is PUBLIC. A leaked credential here is a public credential.

# ---------------------------------------------------------------------------
# REDDIT  (free, works from this container — no cookies needed)
# Create a "script" app: https://www.reddit.com/prefs/apps  -> "create another app"
#   type: script   |   redirect uri: http://localhost:8080  (unused, but required)
# ---------------------------------------------------------------------------
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Required by Reddit's API rules. Format: platform:appname:version (by /u/you)
REDDIT_USER_AGENT=linux:sapro-agent:0.1 (by /u/YOUR_REDDIT_USERNAME)

# Optional. Leave BLANK for public read-only access (app-only token).
# Fill in ONLY if you need account-scoped access (your saved posts, your votes,
# your inbox, posting). Password grant fails if 2FA is on — append :otp code.
REDDIT_USERNAME=
REDDIT_PASSWORD=

# ---------------------------------------------------------------------------
# X / TWITTER  (https://developer.x.com -> project -> Keys and tokens)
# App-only bearer token covers most reads. See social/README.md on tier limits.
# ---------------------------------------------------------------------------
X_BEARER_TOKEN=

# Only needed for acting AS your account (posting, reading your DMs/timeline).
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# ---------------------------------------------------------------------------
# COOKIES — last resort, media download only. See social/README.md.
# Path to a Netscape-format cookies.txt for yt-dlp. Keep it OUT of git.
# ---------------------------------------------------------------------------
X_COOKIES_FILE=
REDDIT_COOKIES_FILE=
